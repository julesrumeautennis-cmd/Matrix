{
  "buildCommand": "npm run vercel-build && npm run build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|data/|screens/|scenery/|avatars/|audio/|textures/|models/).*)",
      "destination": "/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/simulate.ts": {
      "maxDuration": 300
    },
    "api/portraits.ts": {
      "maxDuration": 300
    }
  }
}
